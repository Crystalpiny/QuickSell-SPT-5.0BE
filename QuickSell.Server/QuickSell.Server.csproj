<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <AssemblyName>BlackHawk.QuickSell.Server</AssemblyName>
    <RootNamespace>BlackHawk.QuickSell.Server</RootNamespace>
    <LangVersion>latest</LangVersion>
    <Nullable>disable</Nullable>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <Version>4.3.0</Version>
    <GameRoot Condition="'$(GameRoot)' == ''">$(SPT_ROOT)</GameRoot>
    <SptRuntime>$(GameRoot)\SPT_Runtime</SptRuntime>
  </PropertyGroup>

  <Target Name="ValidateGameRoot" BeforeTargets="PrepareForBuild" Condition="'$(GameRoot)' == ''">
    <Error Text="SPT root not set. Pass -p:SPT_ROOT=C:\path\to\SPT (the folder containing SPT_Runtime)." />
  </Target>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
    <Compile Include="..\QuickSell-Server\**\*.cs" Exclude="..\QuickSell-Server\obj\**;..\QuickSell-Server\bin\**" />
  </ItemGroup>

  <ItemGroup>
    <Reference Include="SPTarkov.Server.Core"><HintPath>$(SptRuntime)\SPTarkov.Server.Core.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="SPTarkov.Common"><HintPath>$(SptRuntime)\SPTarkov.Common.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="SPTarkov.DI"><HintPath>$(SptRuntime)\SPTarkov.DI.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="SemanticVersioning"><HintPath>$(SptRuntime)\SemanticVersioning.dll</HintPath><Private>false</Private></Reference>
  </ItemGroup>

</Project>
